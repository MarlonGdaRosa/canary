# Private RELEASE/.env outside public. Never commit real replacements.
APP_ENV=production
DEV_MODE=false
URL=https://example.invalid
SITE_NAME=REPLACE_SITE_NAME
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=REPLACE_DATABASE
DB_USER=REPLACE_LEAST_PRIVILEGED_USER
DB_PASS=REPLACE_UNIQUE_DATABASE_SECRET
SECURITY_STATE_DIR=/var/lib/canaryaac/security
VIEW_CACHE_DIR=/var/lib/canaryaac/view-cache
OUTFITS_FOLDER=https://example.invalid/resources/images
M_COST=65536
T_COST=2
PARALLELISM=2
# These are documented deployment flags; the reviewed WebSecurity route
# allowlist enforces disabled functionality unconditionally, even if flags change.
FEATURE_ADMIN=false
FEATURE_PAYMENTS=false
FEATURE_RECOVERY=false
FEATURE_UPLOADS=false
FEATURE_EXTERNAL_INTEGRATIONS=false
# No SMTP/payment/Discord/API credentials. Existing configured 2FA verification
# remains enforced; 2FA management and automated recovery remain unavailable.
