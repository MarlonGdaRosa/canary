<?xml version="1.0" encoding="UTF-8"?>
<!-- Server-level applicationHost.config fragment. Do not deploy as web.config.
     Create HTTPS site binding and set public physicalPath explicitly.
     Enable ARR proxy at server scope with timeout 15 seconds.
     Use W3C fields Date,Time,ClientIP,Method,HttpStatus,TimeTaken only. -->
<configuration>
  <system.webServer>
    <fastCgi>
      <application fullPath="C:\REPLACE_PHP\php-cgi.exe" maxInstances="8" instanceMaxRequests="500" activityTimeout="30" requestTimeout="30">
        <environmentVariables>
          <environmentVariable name="PHPRC" value="C:\REPLACE_PRIVATE_CONFIG" />
          <environmentVariable name="PHP_FCGI_MAX_REQUESTS" value="500" />
        </environmentVariables>
      </application>
    </fastCgi>
  </system.webServer>
</configuration>
