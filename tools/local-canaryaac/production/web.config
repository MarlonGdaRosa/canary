<?xml version="1.0" encoding="UTF-8"?>
<!-- Site physicalPath MUST be RELEASE/public. Requires CGI, URL Rewrite 2,
     ARR proxy enabled at server level, Dynamic IP Restrictions and HTTPS binding.
     Register the dedicated PHP FastCGI application from iis-fastcgi.config first.
     Keep server-wide handler inheritance disabled here. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument enabled="false" />
    <handlers accessPolicy="Read,Script">
      <clear />
      <add name="AACIndex" path="index.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\REPLACE_PHP\php-cgi.exe" resourceType="File" requireAccess="Script" />
      <add name="AACStatic" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
    </handlers>
    <security>
      <requestFiltering allowDoubleEscaping="false" removeServerHeader="true">
        <requestLimits maxAllowedContentLength="65536" maxUrl="2048" maxQueryString="1024" />
        <verbs allowUnlisted="false"><clear /><add verb="GET" allowed="true" /><add verb="HEAD" allowed="true" /><add verb="POST" allowed="true" /></verbs>
        <hiddenSegments><add segment=".env" /><add segment=".git" /><add segment="vendor" /><add segment="app" /><add segment="includes" /><add segment="routes" /><add segment="cache" /><add segment="logs" /></hiddenSegments>
      </requestFiltering>
      <dynamicIpSecurity denyAction="Forbidden" enableProxyMode="false">
        <denyByConcurrentRequests enabled="true" maxConcurrentRequests="10" />
        <denyByRequestRate enabled="true" maxRequests="60" requestIntervalInMilliseconds="10000" />
      </dynamicIpSecurity>
    </security>
    <rewrite>
      <rules>
        <clear />
        <rule name="HTTPS" stopProcessing="true"><match url=".*" /><conditions><add input="{HTTPS}" pattern="off" /></conditions><action type="Redirect" url="https://example.invalid/{R:0}" redirectType="Permanent" /></rule>
        <rule name="Private path" stopProcessing="true"><match url="(^|/)\.|\\|//|\.(php[0-9]*|phtml|phar|env|sql|ini|lock|twig|bak|old|log)(\.|/|$)|^(app|includes|routes|vendor|admin|upload)(/|$)" ignoreCase="true" /><action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" /></rule>
        <rule name="Encoded path" stopProcessing="true"><match url=".*" /><conditions><add input="{UNENCODED_URL}" pattern="^[^?]*%(?!20)" /></conditions><action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" /></rule>
        <rule name="Login method" stopProcessing="true"><match url="^login$" /><conditions><add input="{REQUEST_METHOD}" pattern="^POST$" negate="true" /></conditions><action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" /></rule>
        <rule name="Login proxy" stopProcessing="true"><match url="^login$" /><action type="Rewrite" url="http://127.0.0.1:8088/login" appendQueryString="false" /></rule>
        <rule name="Assets" stopProcessing="true"><match url="^resources/(base|bootstrap|canary|icons|images|javascripts|styles)/[a-z0-9_/-][a-z0-9_./-]*\.(css|js|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$" ignoreCase="true" /><conditions><add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" /><add input="{REQUEST_FILENAME}" matchType="IsFile" /></conditions><action type="None" /></rule>
        <rule name="Deny other files" stopProcessing="true"><match url="^resources/|\.[a-z0-9]+(/|$)" ignoreCase="true" /><action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" /></rule>
        <rule name="Front controller" stopProcessing="true"><match url=".*" /><action type="Rewrite" url="index.php" appendQueryString="true" /></rule>
      </rules>
    </rewrite>
    <httpProtocol><customHeaders>
      <remove name="X-Powered-By" />
      <add name="Strict-Transport-Security" value="max-age=31536000" />
      <add name="X-Content-Type-Options" value="nosniff" />
      <add name="X-Frame-Options" value="DENY" />
      <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" />
    </customHeaders></httpProtocol>
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />
    <httpLogging dontLog="false" />
  </system.webServer>
</configuration>
