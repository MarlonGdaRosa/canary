@@ -0,0 +1,28 @@
+<?php
+namespace App\Utils;
+
+use App\Model\Entity\Account;
+use PragmaRX\Google2FA\Google2FA;
+
+final class AccountAuthentication
+{
+    public static function verify(int $accountId, mixed $token): bool
+    {
+        try {
+            $records = Account::getAuthentication(['account_id' => $accountId], null, 2)->fetchAll(\PDO::FETCH_OBJ);
+        } catch (\PDOException $error) {
+            // This optional feature is absent on some core schemas. Every other error fails closed.
+            if (($error->errorInfo[0] ?? null) === '42S02' && ($error->errorInfo[1] ?? null) === 1146) return true;
+            throw $error;
+        }
+        if (count($records) === 0) return true;
+        if (count($records) !== 1) return false;
+        $authentication = $records[0];
+        if (!in_array($authentication->status ?? null, [0, 1, '0', '1'], true)) return false;
+        if ((int) $authentication->status === 0) return true;
+        if (!is_string($token) || !preg_match('/^[0-9]{6}$/D', $token)
+            || !is_string($authentication->secret ?? null) || strlen($authentication->secret) > 128) return false;
+        try { return (new Google2FA())->verifyKey($authentication->secret, $token); }
+        catch (\Throwable $error) { return false; }
+    }
+}
