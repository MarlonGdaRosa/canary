+// Browser hints match the server validator. Passwords are never transformed or sent by AJAX.
+(() => {
+    const field = id => document.getElementById(id);
+    const indicate = (id, valid, message) => {
+        const input = field(id);
+        if (!input) return;
+        input.setCustomValidity(valid ? '' : message);
+        const indicator = field(id + '_indicator');
+        if (indicator) {
+            indicator.classList.toggle('InputIndicatorOK', valid);
+            indicator.classList.toggle('InputIndicatorNotOK', !valid);
+        }
+    };
+    const password = field('password1');
+    const confirmation = field('password2');
+    const checkPassword = () => {
+        const length = Array.from(password.value).length;
+        const valid = length >= 12 && length <= 128 && !password.value.includes('\0');
+        indicate('password1', valid, 'Use 12 to 128 characters without NUL.');
+        indicate('password2', valid && confirmation.value === password.value, 'Enter the same password again.');
+        const badge = field('PWStrengthIndicator');
+        if (badge) badge.textContent = valid ? 'password length accepted' : '12 to 128 characters';
+    };
+    if (password && confirmation) {
+        password.addEventListener('input', checkPassword);
+        confirmation.addEventListener('input', checkPassword);
+    }
+    const rules = {
+        accname: value => /^[A-Za-z0-9]{3,32}$/.test(value),
+        email: value => value.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value),
+        charactername: value => value.length >= 5 && value.length <= 29 && /^[A-Za-z]+(?: [A-Za-z]+)*$/.test(value)
+    };
+    for (const [id, valid] of Object.entries(rules)) {
+        const input = field(id);
+        if (input) input.addEventListener('input', () => indicate(id, valid(input.value), 'Please check this field.'));
+    }
+})();
