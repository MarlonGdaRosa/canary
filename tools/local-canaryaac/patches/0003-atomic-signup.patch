@@ -0,0 +1,24 @@
+<?php
+namespace App\Utils;
+
+final class AccountCreationValidator
+{
+    public static function validate(array $input): array
+    {
+        foreach (['accname', 'email', 'password1', 'password2', 'name', 'sex', 'vocation', 'world', 'agreeagreements'] as $field) {
+            if (!isset($input[$field]) || !is_string($input[$field]) || strlen($input[$field]) > 512
+                || !mb_check_encoding($input[$field], 'UTF-8') || str_contains($input[$field], "\0"))
+                throw new \InvalidArgumentException('Invalid account details');
+        }
+        if (!preg_match('/^[A-Za-z0-9]{3,32}$/D', $input['accname'])
+            || strlen($input['email']) > 254 || !filter_var($input['email'], FILTER_VALIDATE_EMAIL)
+            || !preg_match('/^[A-Za-z]+(?: [A-Za-z]+)*$/D', $input['name'])
+            || strlen($input['name']) < 5 || strlen($input['name']) > 29
+            || mb_strlen($input['password1'], 'UTF-8') < 12 || mb_strlen($input['password1'], 'UTF-8') > 128
+            || $input['password1'] !== $input['password2'] || $input['agreeagreements'] !== 'true'
+            || !in_array($input['sex'], ['1', '2'], true) || !in_array($input['vocation'], ['1', '2', '3', '4', '9'], true)
+            || $input['world'] !== '1') throw new \InvalidArgumentException('Invalid account details');
+        return ['accountName' => $input['accname'], 'email' => strtolower($input['email']), 'password' => $input['password1'],
+            'characterName' => $input['name'], 'sex' => $input['sex'] === '2' ? 0 : 1, 'vocation' => (int) $input['vocation']];
+    }
+}
