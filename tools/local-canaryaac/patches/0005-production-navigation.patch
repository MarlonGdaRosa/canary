diff --git a/app/Utils/WebSecurity.php b/app/Utils/WebSecurity.php
index 637444773..e06c04e0f 100644
--- a/app/Utils/WebSecurity.php
+++ b/app/Utils/WebSecurity.php
@@ -77,6 +77,19 @@ final class WebSecurity
         self::guardRequest();
     }
 
+    public static function productionCacheDirectory(string $path): string
+    {
+        if (!preg_match('#^(?:/|[A-Za-z]:[\\\\/])#', $path)) throw new SecurityFailure(503);
+        // Validate containment before creating any directory.
+        $normalized = str_replace('\\', '/', $path);
+        $root = str_replace('\\', '/', dirname(__DIR__, 2));
+        if (preg_match('#(?:^|/)\.\.?(?:/|$)#', $normalized)) throw new SecurityFailure(503);
+        foreach (['public', 'resources'] as $public) {
+            if (str_starts_with(strtolower(rtrim($normalized, '/') . '/'), strtolower($root . '/' . $public . '/'))) throw new SecurityFailure(503);
+        }
+        return self::privateDirectory($path);
+    }
+
     private static function privateDirectory(string $path): string
     {
         if (is_link($path) || (!is_dir($path) && !@mkdir($path, 0700, true))) throw new SecurityFailure(503);
