diff --git a/app/Utils/RateLimiter.php b/app/Utils/RateLimiter.php
new file mode 100644
index 0000000..dd991af
--- /dev/null
+++ b/app/Utils/RateLimiter.php
@@ -0,0 +1,37 @@
+<?php
+namespace App\Utils;
+
+final class RateLimiter
+{
+    public static function consume(string $directory, string $action, string $address): void
+    {
+        $budgets = ['signup' => [5, 600], 'login' => [10, 900]];
+        if (!isset($budgets[$action]) || filter_var($address, FILTER_VALIDATE_IP) === false) throw new SecurityFailure(503);
+        [$limit, $window] = $budgets[$action];
+        $file = $directory . '/' . hash('sha256', $action . "\0" . $address) . '.json';
+        if (is_link($file)) throw new SecurityFailure(503);
+        $handle = @fopen($file, 'c+b');
+        if ($handle === false) throw new SecurityFailure(503);
+        try {
+            if (!flock($handle, LOCK_EX)) throw new SecurityFailure(503);
+            $data = stream_get_contents($handle, 4097);
+            if ($data === false || strlen($data) > 4096) throw new SecurityFailure(503);
+            $now = time();
+            $state = $data === '' ? ['start' => $now, 'count' => 0] : json_decode($data, true);
+            if (!is_array($state) || !is_int($state['start'] ?? null) || !is_int($state['count'] ?? null)
+                || $state['start'] > $now || $state['count'] < 0 || $state['count'] > $limit) throw new SecurityFailure(503);
+            if ($now - $state['start'] >= $window) $state = ['start' => $now, 'count' => 0];
+            if ($state['count'] >= $limit) throw new SecurityFailure(429, max(1, $window - ($now - $state['start'])));
+            ++$state['count'];
+            $encoded = json_encode($state, JSON_THROW_ON_ERROR);
+            if (!rewind($handle) || !ftruncate($handle, 0) || fwrite($handle, $encoded) !== strlen($encoded) || !fflush($handle)) throw new SecurityFailure(503);
+        } catch (\ErrorException $error) {
+            // Checked native storage operations can warn before returning failure.
+            throw new SecurityFailure(503);
+        } finally {
+            $unlocked = @flock($handle, LOCK_UN);
+            $closed = @fclose($handle);
+            if (!$unlocked || !$closed) throw new SecurityFailure(503);
+        }
+    }
+}
