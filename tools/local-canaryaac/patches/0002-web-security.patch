diff --git a/app/Utils/WebSecurity.php b/app/Utils/WebSecurity.php
new file mode 100644
index 0000000..6c12193
--- /dev/null
+++ b/app/Utils/WebSecurity.php
@@ -0,0 +1,162 @@
+<?php
+namespace App\Utils;
+
+final class WebSecurity
+{
+    private static bool $production = false;
+    private static string $stateDirectory;
+
+    public static function installErrorBoundary(): void
+    {
+        ini_set('display_errors', '0');
+        ini_set('display_startup_errors', '0');
+        set_error_handler(static function (int $severity): bool {
+            if ((error_reporting() & $severity) === 0) return false;
+            throw new \ErrorException('Request failed', $severity, $severity);
+        });
+        set_exception_handler(static function (\Throwable $error): void {
+            if ($error instanceof SecurityFailure && $error->retryAfter > 0) header('Retry-After: ' . $error->retryAfter);
+            self::respondToFailure($error);
+        });
+    }
+
+    public static function respondToFailure(\Throwable $error): void
+    {
+        $status = $error instanceof SecurityFailure ? $error->getCode() : 500;
+        $messages = [400 => 'Bad Request', 403 => 'Forbidden', 404 => 'Not Found', 429 => 'Too Many Requests',
+            503 => 'Service Unavailable', 500 => 'Internal Server Error'];
+        if (!isset($messages[$status])) $status = 500;
+        if ($status >= 500) error_log('CanaryAAC exception type=' . get_class($error) . ' code=' . (int) $error->getCode());
+        http_response_code($status);
+        header('Content-Type: text/plain; charset=utf-8');
+        header('Cache-Control: no-store');
+        if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'HEAD') echo $messages[$status];
+    }
+
+    public static function boot(array $environment): void
+    {
+        self::$production = ($environment['APP_ENV'] ?? 'local') === 'production';
+        if (!in_array($environment['APP_ENV'] ?? 'local', ['local', 'production'], true)) throw new SecurityFailure(503);
+        if (self::$production) {
+            $url = parse_url($environment['URL'] ?? '');
+            $host = strtolower($url['host'] ?? '');
+            if (($url['scheme'] ?? '') !== 'https' || !str_contains($host, '.') || filter_var($host, FILTER_VALIDATE_IP)
+                || $host === 'localhost' || str_ends_with($host, '.localhost') || str_ends_with($host, '.invalid')
+                || isset($url['user']) || isset($url['pass']) || isset($url['query']) || isset($url['fragment'])
+                || !in_array(strtolower((string) ($_SERVER['HTTPS'] ?? '')), ['on', '1'], true)) throw new SecurityFailure(503);
+            header('Strict-Transport-Security: max-age=31536000');
+        }
+        header('X-Content-Type-Options: nosniff');
+        header('X-Frame-Options: DENY');
+        header('Referrer-Policy: strict-origin-when-cross-origin');
+        header("Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'");
+        header('Cache-Control: no-store');
+        $state = $environment['SECURITY_STATE_DIR'] ?? dirname(__DIR__, 3) . '/canaryaac-security-state';
+        if (self::$production && !isset($environment['SECURITY_STATE_DIR'])) throw new SecurityFailure(503);
+        self::$stateDirectory = self::privateDirectory($state);
+        $sessions = self::privateDirectory(self::$stateDirectory . '/sessions');
+        self::privateDirectory(self::$stateDirectory . '/limits');
+        if (session_status() !== PHP_SESSION_ACTIVE) {
+            ini_set('session.use_strict_mode', '1');
+            ini_set('session.use_only_cookies', '1');
+            ini_set('session.use_trans_sid', '0');
+            session_save_path($sessions);
+            $name = $environment['SITE_NAME'] ?? 'CanaryAAC';
+            if (!is_string($name) || !preg_match('/^[A-Za-z][A-Za-z0-9]{0,63}$/D', $name)) throw new SecurityFailure(503);
+            session_name($name);
+            session_set_cookie_params(['lifetime' => 0, 'path' => '/', 'secure' => self::$production,
+                'httponly' => true, 'samesite' => 'Lax']);
+            try {
+                if (!session_start()) throw new SecurityFailure(503);
+            } catch (\ErrorException $error) {
+                // Native session storage warnings are expected availability failures.
+                throw new SecurityFailure(503);
+            }
+        }
+        self::csrfToken();
+        self::guardRequest();
+    }
+
+    private static function privateDirectory(string $path): string
+    {
+        if (is_link($path) || (!is_dir($path) && !@mkdir($path, 0700, true))) throw new SecurityFailure(503);
+        $resolved = realpath($path);
+        if (!$resolved || !is_writable($resolved)) throw new SecurityFailure(503);
+        $appRoot = realpath(dirname(__DIR__, 2));
+        foreach (['public', 'resources'] as $public) {
+            $forbidden = $appRoot . DIRECTORY_SEPARATOR . $public;
+            if (str_starts_with(strtolower($resolved . DIRECTORY_SEPARATOR), strtolower($forbidden . DIRECTORY_SEPARATOR))) throw new SecurityFailure(503);
+        }
+        return $resolved;
+    }
+
+    private static function guardRequest(): void
+    {
+        $method = $_SERVER['REQUEST_METHOD'] ?? 'GET';
+        $path = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH);
+        if (!is_string($path)) throw new SecurityFailure(400);
+        // Keep route identity identical to Router: encoded and ambiguous paths are never aliases.
+        $characterPath = preg_match('#^/community/characters/[A-Za-z]+(?:(?:%20| )[A-Za-z]+)*$#D', $path) === 1;
+        if ((str_contains($path, '%') && !$characterPath) || str_contains($path, '\\') || str_contains($path, '//') || preg_match('#(?:^|/)\.#', $path)) throw new SecurityFailure(404);
+        $path = rtrim($path, '/') ?: '/';
+        $gets = ['/', '/latestnews', '/createaccount', '/account/login', '/account', '/downloads', '/newsarchive',
+            '/community/characters', '/community/worlds', '/community/highscores', '/community/lastdeaths',
+            '/support/rules', '/support/team', '/library/creatures', '/library/boostablebosses',
+            '/library/achievements', '/library/experiencetable'];
+        if (!self::$production) $gets[] = '/account/createcharacter';
+        $readOnlyDynamic = preg_match('#^/(?:community/characters/[^/]+|newsarchive/[0-9]+/view)$#D', $path) === 1;
+        if (in_array($method, ['GET', 'HEAD'], true)) {
+            if (!in_array($path, $gets, true) && !$readOnlyDynamic) throw new SecurityFailure(404);
+            return;
+        }
+        if ($method !== 'POST' || !in_array($path, ['/createaccount', '/account/login', '/account/logout'], true)) throw new SecurityFailure(404);
+        $length = $_SERVER['CONTENT_LENGTH'] ?? '0';
+        if (!ctype_digit((string) $length) || (float) $length > 65536) throw new SecurityFailure(400);
+        // Also bound requests without Content-Length before the application parses them.
+        $input = fopen('php://input', 'rb');
+        $body = $input === false ? false : stream_get_contents($input, 65537);
+        if (is_resource($input)) fclose($input);
+        if ($body === false || strlen($body) > 65536) throw new SecurityFailure(400);
+        self::requireCsrf($_POST);
+        if ($path === '/createaccount' || $path === '/account/login')
+            self::checkRateLimit($path === '/createaccount' ? 'signup' : 'login', $_SERVER['REMOTE_ADDR'] ?? '');
+    }
+
+    public static function csrfToken(): string
+    {
+        if (!is_string($_SESSION['csrf_token'] ?? null) || strlen($_SESSION['csrf_token']) !== 64)
+            $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
+        return $_SESSION['csrf_token'];
+    }
+
+    public static function requireCsrf(array $post): void
+    {
+        if (!is_string($post['csrf_token'] ?? null) || !is_string($_SESSION['csrf_token'] ?? null)
+            || !hash_equals($_SESSION['csrf_token'], $post['csrf_token'])) throw new SecurityFailure(403);
+    }
+
+    public static function checkRateLimit(string $action, string $remoteAddress): void
+    {
+        RateLimiter::consume(self::$stateDirectory . '/limits', $action, $remoteAddress);
+    }
+
+    public static function debugEnabled(mixed $value): bool
+    {
+        return !self::$production && filter_var($value, FILTER_VALIDATE_BOOLEAN) === true;
+    }
+
+    public static function authenticated(): void
+    {
+        if (!@session_regenerate_id(true)) throw new SecurityFailure(503);
+        $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
+    }
+
+    public static function logout(): void
+    {
+        $_SESSION = [];
+        $cookie = session_get_cookie_params();
+        setcookie(session_name(), '', ['expires' => time() - 3600, 'path' => $cookie['path'],
+            'secure' => $cookie['secure'], 'httponly' => true, 'samesite' => 'Lax']);
+        if (!@session_destroy()) throw new SecurityFailure(503);
+    }
+}
